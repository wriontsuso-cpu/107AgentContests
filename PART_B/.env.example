LLM_PROVIDER=placeholder
LLM_API_KEY=fill-your-api-key-here
LLM_MODEL=fill-your-model-name-here
# Optional for OpenAI-compatible third-party providers:
# LLM_BASE_URL=https://api.example.com/v1
LLM_TIMEOUT_SECONDS=30

# The local JSON dataset required by 数据接口规范.md.
KNOWLEDGE_BASE_PROVIDER=json
KNOWLEDGE_BASE_TOP_K=5
# Optional; defaults to ../data without log in/原始数据_整合.json
# KNOWLEDGE_BASE_DATA_PATH=../data without log in/原始数据_整合.json

# Reserved for a future remote database adapter.
# KNOWLEDGE_BASE_ENDPOINT=https://database.example.com/search
# KNOWLEDGE_BASE_API_KEY=fill-your-database-key-here

# Comma-separated frontend origins allowed to call the web API.
WEB_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
